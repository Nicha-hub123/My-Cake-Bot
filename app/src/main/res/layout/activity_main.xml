<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="@color/bg_main" android:fillViewport="true" android:layout_height="match_parent" android:layout_width="match_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="16dp">

        <!-- Header -->
        <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">

            <TextView android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="@string/app_name" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>

            <TextView android:background="#1E1B4B" android:layout_height="wrap_content" android:layout_width="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="@string/badge_unlimited" android:textColor="@color/accent_cyan" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- Mode Toggle Tabs -->
        <LinearLayout android:background="@color/bg_card" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:orientation="horizontal" android:padding="4dp">

            <Button android:backgroundTint="@color/accent_purple" android:id="@+id/btnTabImage" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="@string/tab_image" android:textColor="@color/text_primary" style="?attr/materialButtonOutlinedStyle"/>

            <Button android:id="@+id/btnTabVideo" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="@string/tab_video" android:textColor="@color/text_secondary" style="?attr/materialButtonOutlinedStyle"/>
        </LinearLayout>

        <!-- Control Panel -->
        <androidx.cardview.Widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="16dp">

                <TextView android:id="@+id/txtPanelTitle" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="@string/panel_title_image" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>

                <TextView android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:text="@string/prompt_label" android:textColor="@color/text_secondary" android:textSize="13sp"/>

                <EditText android:background="@color/bg_main" android:gravity="top|start" android:hint="@string/prompt_placeholder" android:id="@+id/etPrompt" android:layout_height="100dp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:padding="10dp" android:textColor="@color/text_primary" android:textColorHint="#475569" android:textSize="14sp"/>

                <!-- Options -->
                <TextView android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:text="@string/engine_label" android:textColor="@color/text_secondary" android:textSize="13sp"/>

                <Spinner android:background="@color/bg_main" android:id="@+id/spinnerEngine" android:layout_height="48dp" android:layout_marginTop="4dp" android:layout_width="match_parent"/>

                <Button android:backgroundTint="@color/accent_cyan" android:id="@+id/btnGenerate" android:layout_height="54dp" android:layout_marginTop="16dp" android:layout_width="match_parent" android:text="@string/btn_generate_image" android:textColor="#000000" android:textStyle="bold"/>
            </LinearLayout>
        </androidx.cardview.Widget.CardView>

        <!-- Preview Card -->
        <androidx.cardview.Widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="@string/preview_title" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>

                <FrameLayout android:background="@color/bg_main" android:layout_height="280dp" android:layout_marginTop="12dp" android:layout_width="match_parent">

                    <ProgressBar android:id="@+id/progressBar" android:layout_gravity="center" android:layout_height="wrap_content" android:layout_width="wrap_content" android:visibility="gone"/>

                    <ImageView android:contentDescription="Result AI Image" android:id="@+id/imgResult" android:layout_height="match_parent" android:layout_width="match_parent" android:scaleType="centerCrop"/>

                    <VideoView android:id="@+id/videoResult" android:layout_height="match_parent" android:layout_width="match_parent" android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>
        </androidx.cardview.Widget.CardView>

    </LinearLayout>
</ScrollView>
